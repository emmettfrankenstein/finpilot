# Copy to .env (git-ignored) and change the values. Never commit .env.

# PostgreSQL
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Local HTTP only: allow the refresh cookie without TLS. Always true behind HTTPS.
REFRESH_COOKIE_SECURE=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Demo users created by `manage.py create_demo_users` (local/demo only)
DEMO_VIEWER_PASSWORD=change-me-viewer
DEMO_ADMIN_PASSWORD=change-me-admin

# Seed the supplied CSVs when the API container starts
SEED_ON_START=true
